# Copy this file to .env and fill in your real keys for local testing with `vercel dev`.
# In production, set these in Vercel: Project Settings -> Environment Variables.

# Required — powers script generation (api/generate.js)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional — powers "Generate reference image" on the Cast cards (api/generate-image.js).
# Separate provider, separate billing. The tool works fully without this; only the
# image buttons need it. Get a key at https://aistudio.google.com (Google AI Studio).
GEMINI_API_KEY=your-gemini-api-key-here
