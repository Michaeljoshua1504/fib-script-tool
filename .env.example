# Copy this file to .env and fill in your real keys for local testing with `vercel dev`.
# In production, set these in Vercel: Project Settings -> Environment Variables.

# Required — powers script generation (api/generate.js) AND reference images
# (api/generate-image.js). Free key at https://aistudio.google.com (Google AI Studio).
GEMINI_API_KEY=your-gemini-api-key-here

# Optional — use Claude for the script instead of Gemini:
# SCRIPT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional — override the Gemini text model (default gemini-3.5-flash-lite)
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Optional — image provider for "Generate illustration" / character images.
# Default is Pollinations (free, no key, but ~1 image per 45s per IP and can be busy).
# A free key from https://enter.pollinations.ai raises those limits:
# POLLINATIONS_API_KEY=your-pollinations-key
# Or use Gemini images (needs a billed Google project):
# IMAGE_PROVIDER=gemini

# Recommended image provider: Cloudflare Workers AI (free allowance, no watermark).
# IMAGE_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-workers-ai-token

# Optional — require a shared password to use the tool (leave unset to keep it open).
# APP_PASSWORD=choose-a-long-random-password
